# Python-generated files
__pycache__/
*.py[oc]
design/
scripts/*
!scripts/publish-docker.sh
!scripts/bump-version.sh
# Tracked: CI runs it as a gate, and the Docker build runs it to collect the
# bundled dependencies' licence texts.
!scripts/gen-third-party-notices.py
# Canonical licence texts the generator reproduces for packages that
# ship none of their own.
!scripts/license-texts/
# Tracked: CI and both publishing workflows run it to verify that every
# Action pin still matches the release its comment names.
!scripts/check-action-pins.sh
build/
dist/
wheels/
*.egg-info
.env

# Virtual environments
.venv
venv/
env/

# IDE cache files
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Import folder
import/

# Temporary chart files
tmp/

# Blog drafts (not tracked in repo)
blog/

# Test files in main directory
/test_*.py

# Review reports
review*

# OS specific
.DS_Store
Thumbs.db

# Generated files and images
*.png
*.jpg
*.jpeg
*.gif

# Allow assets directory (logos etc.)
!assets/
!assets/*

# MCP connection state
.mcpregistry_github_token
.mcpregistry_registry_token
.claude/settings.local.json
